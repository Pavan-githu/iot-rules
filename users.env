ADMIN_PRIVATE_KEY=0xYourAdminPrivateKeyHere

# FirmwareMetadataStore — writeFirmwareMetadata
# Get CONTRACT_ADDR from: npx hardhat run blockchain/deploy.js --network localhost
# It is printed under [2/2] firmware.conf as FIRMWARE_CONTRACT=0x...
RPC_URL=http://192.168.1.5:8545
CONTRACT_ADDR=0xPaste_FirmwareMetadataStore_Address_Here
SIGNER_KEY=0x

# Optional: override default metadata path
# METADATA_JSON=/path/to/firmware-metadata.json